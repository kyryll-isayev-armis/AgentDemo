@using AgentDemo.Web.Game

<div class="stage">
    <div class="@BoardClass" role="group" aria-label="@Label" aria-describedby="@(ShowHelp ? "board-hint" : null)">
        @for (var i = 0; i < GameState.CellCount; i++)
        {
            var index = i;
            var cell = Game.Cells[index];
            var playable = IsPlayable(index);
            var win = Game.WinningLine.Contains(index);
            var fading = Game.FadingCell == index;
            var hinted = HintCell == index && playable;
            <button type="button"
                    @ref="_cells[index]"
                    class="cell @(win ? "win" : "") @(fading ? "fading" : "") @(hinted ? "hinted" : "")"
                    aria-label="@CellLabel(index, cell, win, fading, hinted)"
                    aria-disabled="@(playable ? null : "true")"
                    @onclick="() => Play(index)"
                    @onkeydown="e => OnKey(index, e)">
                <Mark Side="@cell" />
            </button>
        }
        @if (Game.Winner != Player.None)
        {
            var (x1, y1, x2, y2) = BeamCoordinates();
            <svg class="beam" viewBox="0 0 316 316" aria-hidden="true" focusable="false">
                <line class="beam-glow" x1="@x1" y1="@y1" x2="@x2" y2="@y2" pathLength="1" />
                <line class="beam-core" x1="@x1" y1="@y1" x2="@x2" y2="@y2" pathLength="1" />
            </svg>
        }
        @if (Game.IsDraw)
        {
            <div class="static-noise" aria-hidden="true"></div>
            <span class="static-badge" aria-hidden="true">STATIC</span>
        }
    </div>
</div>

@if (Game.Rules == RuleSet.Decay)
{
    <p class="legend">
        <span class="legend-swatch" aria-hidden="true"></span>
        <span><strong>DECAY:</strong> a dashed, flickering mark is the mover's oldest. It vanishes on their next move, and they cannot replay that cell.</span>
    </p>
}

@if (ShowHelp)
{
<p id="board-hint" class="hotkeys">Arrow keys move between cells (they stop at the edges). 1-9 play a cell. Enter or Space plays the focused cell. U undo. H hint. N next round. M mute.</p>
}

@code {
    private readonly ElementReference[] _cells = new ElementReference[GameState.CellCount];

    [Parameter, EditorRequired] public GameState Game { get; set; } = default!;

    [Parameter] public bool Locked { get; set; }

    [Parameter] public int? HintCell { get; set; }

    [Parameter] public bool ShowHelp { get; set; } = true;

    [Parameter] public string Label { get; set; } = "Game board";

    [Parameter] public EventCallback<int> OnCellPlay { get; set; }

    public async ValueTask FocusCellAsync(int index)
    {
        if (index is >= 0 and < GameState.CellCount)
        {
            await _cells[index].FocusAsync();
        }
    }

    public ValueTask FocusFirstLegalAsync() =>
        FocusCellAsync(Game.LegalMoves.Count > 0 ? Game.LegalMoves[0] : 0);

    private string BoardClass =>
        "board" +
        (Game.Winner == Player.X ? " won win-x" : Game.Winner == Player.O ? " won win-o" : "") +
        (Game.IsDraw ? " draw" : "") +
        (Game.Rules == RuleSet.Decay ? " decay" : "");

    private bool IsPlayable(int index) => !Locked && !Game.IsOver && Game.Cells[index] == Player.None;

    private async Task Play(int index)
    {
        if (IsPlayable(index))
        {
            await OnCellPlay.InvokeAsync(index);
        }
    }

    private async Task OnKey(int index, KeyboardEventArgs e)
    {
        if (BoardNavigator.IsArrow(e.Key))
        {
            await FocusCellAsync(BoardNavigator.Move(index, e.Key));
        }
    }

    private static string CellLabel(int index, Player p, bool win, bool fading, bool hinted)
    {
        var state = p == Player.None ? "empty" : p.ToString();
        return $"Row {index / GameState.Size + 1}, column {index % GameState.Size + 1}, {state}" +
               (win ? ", winning cell" : "") + (fading ? ", fading" : "") + (hinted ? ", suggested move" : "");
    }

    private (double, double, double, double) BeamCoordinates()
    {
        // 316-unit box: cells are 100 wide with an 8 gap, so centres sit at 50, 158, 266.
        static (double X, double Y) Centre(int i) => (50 + 108 * (i % GameState.Size), 50 + 108 * (i / GameState.Size));
        var line = Game.WinningLine;
        var a = Centre(line[0]);
        var b = Centre(line[^1]);
        var dx = b.X - a.X;
        var dy = b.Y - a.Y;
        var len = Math.Sqrt(dx * dx + dy * dy);
        const double extend = 24;
        var ux = dx / len * extend;
        var uy = dy / len * extend;
        return (Math.Round(a.X - ux, 1), Math.Round(a.Y - uy, 1), Math.Round(b.X + ux, 1), Math.Round(b.Y + uy, 1));
    }
}
