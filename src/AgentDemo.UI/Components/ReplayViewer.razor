@using AgentDemo.Web.Game

<div class="replay">
    <h3 id="replay-title" tabindex="-1" @ref="_heading">Replay · @Names.Rules(Record.Settings.Rules)</h3>

    @if (Record.Rounds.Count > 1)
    {
        <div class="replay-rounds" role="group" aria-label="Round">
            @for (var i = 0; i < Record.Rounds.Count; i++)
            {
                var index = i;
                <button type="button" class="btn" aria-pressed="@(index == _round ? "true" : "false")" @onclick="() => SelectRound(index)">Round @(index + 1)</button>
            }
        </div>
    }

    <Board Game="_state" Locked="true" ShowHelp="false" Label="Replay board" />

    <p class="replay-status" role="status" aria-live="polite" aria-atomic="true">@StatusText</p>

    <div class="replay-controls" role="group" aria-label="Replay controls">
        <button type="button" class="btn" disabled="@(_step == 0)" @onclick="() => Go(0)">⏮ Start</button>
        <button type="button" class="btn" disabled="@(_step == 0)" @onclick="() => Go(_step - 1)">◀ Back</button>
        <button type="button" class="btn" disabled="@(_step >= Moves.Count)" @onclick="() => Go(_step + 1)">Next ▶</button>
        <button type="button" class="btn" disabled="@(_step >= Moves.Count)" @onclick="() => Go(Moves.Count)">End ⏭</button>
    </div>

    <div class="btn-row">
        <button type="button" class="btn btn-primary" @onclick="OnBack">Back to history</button>
    </div>
</div>

@code {
    private ElementReference _heading;
    private int _round;
    private int _step;
    private GameState _state = new();

    [Parameter, EditorRequired] public MatchRecord Record { get; set; } = default!;

    [Parameter] public EventCallback OnBack { get; set; }

    private RoundRecord Round => Record.Rounds[_round];

    private IReadOnlyList<int> Moves => Round.Moves;

    protected override void OnParametersSet()
    {
        _round = Math.Clamp(_round, 0, Math.Max(0, Record.Rounds.Count - 1));
        Rebuild();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _heading.FocusAsync();
        }
    }

    private void SelectRound(int index)
    {
        _round = index;
        _step = 0;
        Rebuild();
    }

    private void Go(int step)
    {
        _step = Math.Clamp(step, 0, Moves.Count);
        Rebuild();
    }

    private void Rebuild() => _state = Replay.StateAt(Record.Settings.Rules, Round, _step);

    private string StatusText
    {
        get
        {
            if (_step == 0)
            {
                return $"Round {_round + 1}, start. {Names.Side(Round.Starter)} opens. {Moves.Count} moves.";
            }

            var cell = Moves[_step - 1];
            var mover = _step % 2 == 1 ? Round.Starter : (Round.Starter == Player.X ? Player.O : Player.X);
            var faded = Record.Settings.Rules == RuleSet.Decay
                && Replay.StateAt(Record.Settings.Rules, Round, _step - 1).FadingCell.HasValue;
            var text = $"Move {_step} of {Moves.Count}: {Names.Side(mover)} at row {cell / GameState.Size + 1}, column {cell % GameState.Size + 1}.";
            if (faded) text += " Oldest mark faded.";
            if (_state.IsOver) text += _state.Winner == Player.None ? " Draw." : $" {Names.Side(_state.Winner)} wins the round.";
            return text;
        }
    }
}
