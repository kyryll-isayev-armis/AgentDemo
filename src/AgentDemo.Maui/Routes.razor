@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="typeof(AgentDemo.Web.Components.Pages.Home).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
    </Found>
    <NotFound>
        <LayoutView>
            <p>Not found.</p>
        </LayoutView>
    </NotFound>
</Router>
